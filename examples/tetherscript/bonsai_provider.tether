// Runnable front door to the dedicated in-process Bonsai provider.
// Usage: tetherscript run examples/tetherscript/bonsai_provider.tether -- "Your prompt"
// With no arguments, run a small native inference smoke request.
fn name() { return "bonsai" }
fn models() { return ["ternary-bonsai-2-27b-pq2"] }
fn invocation(arguments) {
    let mut prompt = "Reply with exactly BONSAI_NATIVE_OK and nothing else."
    if arguments.len() > 0 { prompt = arguments.join(" ") }
    return ["bonsai", "--max-tokens", "64", "--prompt", prompt]
}
fn run(arguments) {
    let mut executable = env_get("CODETETHER_BIN")?
    if executable == nil || executable == "" { executable = "codetether" }
    let probe = process_run(executable, ["bonsai", "--help"], nil, 10000)?
    if !probe["success"] {
        return Err("Installed CodeTether has no native Bonsai command. Install this checkout with candle-cuda; no fallback provider was invoked.")
    }
    println("Running native Bonsai on CUDA; first use includes model loading and prompt prefill.")
    let result = process_run(executable, invocation(arguments), nil, 300000)?
    if result["stdout"] != "" { println(result["stdout"]) }
    if result["stderr"] != "" { println(result["stderr"]) }
    if result["timed_out"] { return Err("Native Bonsai request exceeded five minutes") }
    if !result["success"] { return Err("Native Bonsai command exited with code " + str(result["code"])) }
    return Ok(nil)
}
fn main() {
    let arguments = env_args()
    if arguments.len() == 1 && arguments[0] == "--help" {
        println("Usage: tetherscript run examples/tetherscript/bonsai_provider.tether -- [prompt]")
        println("Runs codetether bonsai, using native Candle/CUDA. No HTTP server or cloud provider.")
        return Ok(nil)
    }
    run(arguments).unwrap()
}