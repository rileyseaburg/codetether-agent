//! Direct GLM-5.3 call via the standard Z.AI chat completions endpoint.
//!
//! The API key is passed as an argument (never hardcoded). The host
//! injects it from Vault so the secret never lives in this file.
//!
//! Usage: hook "call" with args [api_key, prompt].

fn call(api_key, prompt) {
    let url = "https://api.z.ai/api/paas/v4/chat/completions"

    let body_map = map()
    body_map["model"] = "glm-5.3"

    let msg = map()
    msg["role"] = "user"
    msg["content"] = prompt

    body_map["messages"] = [msg]
    body_map["max_tokens"] = 512
    body_map["temperature"] = 0.7

    let body = json_encode(body_map)

    let headers = map()
    headers["Authorization"] = "Bearer " + api_key
    headers["Content-Type"] = "application/json"

    let result = http_request("POST", url, body, headers)
    let resp = result?

    let summary = map()

    if resp["ok"] == true {
        let parsed = json_parse(resp["body"])
        summary["status"] = 200
        summary["model"] = parsed["model"]
        let choices = parsed["choices"]
        if len(choices) > 0 {
            summary["content"] = choices[0]["message"]["content"]
        }
        summary["usage"] = parsed["usage"]
        summary["raw_ok"] = true
        return Ok(summary)
    }

    summary["status"] = resp["status"]
    summary["raw_ok"] = false
    summary["body"] = resp["body"]
    return Ok(summary)
}
