// Scalar reference for the gated linear recurrence.
//
// Sequential, obviously correct, and deliberately slow. Every faster
// implementation must match this within floating-point tolerance, including
// the CUDA kernel. Derivation lives in docs/research/gated_recurrence.md.
//
//   S_t = a_t * S_{t-1} + v_t k_t^T
//   y_t = S_t q_t

fn zeros(rows, cols) {
    let m = list()
    let r = 0
    while r < rows {
        let row = list()
        let c = 0
        while c < cols {
            row.push(0.0)
            c = c + 1
        }
        m.push(row)
        r = r + 1
    }
    return m
}

// Apply S -> a*S + v k^T, returning a new state.
fn state_step(state, a, v, k) {
    let dv = v.len()
    let dk = k.len()
    let out = list()
    let i = 0
    while i < dv {
        let row = list()
        let j = 0
        while j < dk {
            let decayed = a * state[i][j]
            row.push(decayed + v[i] * k[j])
            j = j + 1
        }
        out.push(row)
        i = i + 1
    }
    return out
}

// Return S q for a d_v x d_k state and a length d_k query.
fn state_apply(state, q) {
    let out = list()
    let i = 0
    while i < state.len() {
        let acc = 0.0
        let j = 0
        while j < q.len() {
            acc = acc + state[i][j] * q[j]
            j = j + 1
        }
        out.push(acc)
        i = i + 1
    }
    return out
}
