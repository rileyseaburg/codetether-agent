# Harvester worker with mandatory repository-hook enforcement.
#
# Layers the hook tooling and a gate-enforcing codetether binary over the
# currently deployed harvester image, so every other tool (node/pnpm, vault,
# rustyroad, forgejo-cli, forgejo_auth.py) is unchanged.
#
# Build (from codetether-agent/, after `cargo build --release --bin codetether`):
#   cp target/release/codetether codetether-hookgate-bin
#   docker build -f Dockerfile.worker-hookgate \
#     -t registry.quantum-forge.net/cluster-ci-cache/codetether-worker:<tag> .

ARG BASE=registry.quantum-forge.net/cluster-ci-cache/codetether-worker:4.7.5-dev.49-forgejo-ro-599230d97ec3
FROM ${BASE}

# Base runs as root; Kubernetes sets uid 1000, so the user is not changed.
ENV DEBIAN_FRONTEND=noninteractive

# Repository hook tooling. Pushes are refused unless each repository's declared
# pre-commit/post-commit/pre-push hooks are installed and executable.
ARG PRE_COMMIT_VERSION=4.2.0
ARG GITLEAKS_VERSION=8.28.0
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/pre-commit \
    && /opt/pre-commit/bin/pip install --no-cache-dir \
        "pre-commit==${PRE_COMMIT_VERSION}" \
    && ln -sf /opt/pre-commit/bin/pre-commit /usr/local/bin/pre-commit \
    && curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
        -o /tmp/gitleaks.tar.gz \
    && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && rm /tmp/gitleaks.tar.gz \
    && pre-commit --version && gitleaks version

# The gate itself lives in the worker binary (a2a/worker/git_hook_gate.rs).
COPY codetether-hookgate-bin /usr/local/bin/codetether
RUN chmod 0755 /usr/local/bin/codetether && codetether --version

HEALTHCHECK --interval=60s --timeout=10s --start-period=15s \
  CMD command -v git >/dev/null && command -v node >/dev/null \
      && command -v pre-commit >/dev/null && command -v gitleaks >/dev/null \
      || exit 1
