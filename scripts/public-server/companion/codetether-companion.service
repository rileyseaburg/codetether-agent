[Unit]
Description=CodeTether opt-in screen analysis relay
After=network-online.target codetether-spotlessbinco-thinker.service
Wants=network-online.target
[Service]
ExecStart=@NODE@ @ROOT@/server.ts
WorkingDirectory=@ROOT@
EnvironmentFile=%h/.config/codetether-public-server/origin.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
MemoryMax=256M
LimitCORE=0
[Install]
WantedBy=default.target